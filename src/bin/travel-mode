#!/bin/bash
# travel-mode: keep a Mac awake with the lid closed, lock the screen when the lid closes,
# check that Wi-Fi is on an iPhone Personal Hotspot, and rejoin that hotspot if Wi-Fi drops.
#
#   travel-mode on | off | toggle | status
#   travel-mode wifi              -> "<state><TAB><message>", state = hotspot | other | off | none
#   travel-mode join [name]       -> join the last hotspot (or <name>) and wait until it is up
#   travel-mode hotspot [name]    -> show or set the hotspot to rejoin (learned automatically)
#   travel-mode networks          -> list saved Wi-Fi networks
#   travel-mode log               -> show recent lid-lock and reconnect events
set -u

SELF="$(/usr/bin/readlink -f "$0" 2>/dev/null || echo "$0")"
BIN_DIR="$(cd "$(/usr/bin/dirname "$SELF")" && pwd)"
LABEL="io.github.ahendraatmaja.mac-travel-mode.lid-lock"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
CONF_DIR="${TM_CONF_DIR:-$HOME/Library/Application Support/Travel Mode}"
HOTSPOT_FILE="$CONF_DIR/hotspot-name"
LOG="${TM_LOG:-$HOME/Library/Logs/travel-mode.log}"
HOTSPOT_ROUTER="172.20.10.1"   # iPhone / iPad Personal Hotspot always uses 172.20.10.0/28

# Test hooks (used by test.sh only): TM_TEST=1 fakes "travel mode on", replays Wi-Fi states from
# TM_TEST_WIFI (comma list, one per 10 s check), reports TM_TEST_NAME as the network name, uses a
# simulated clock (2 s per loop), logs joins instead of running them, stops after TM_TEST_TICKS loops.
TM_TEST="${TM_TEST:-}"

is_on() {
  [ -n "$TM_TEST" ] && return 0
  /usr/bin/pmset -g | /usr/bin/grep -q 'SleepDisabled[[:space:]]*1'
}

tm_log() { /bin/mkdir -p "$(/usr/bin/dirname "$LOG")"; echo "$(/bin/date '+%F %T') $*" >> "$LOG"; }

wifi_dev() { /usr/sbin/networksetup -listallhardwareports | /usr/bin/awk '/Wi-Fi/{getline; print $2; exit}'; }

wifi_name() { # name of the Wi-Fi network we're on, if the helper can read it
  [ -x "$BIN_DIR/wifiname" ] && "$BIN_DIR/wifiname" "$(wifi_dev)" 2>/dev/null
}

admin() { # $1 = shell command run as root, $2 = reason shown in the macOS password dialog
  /usr/bin/osascript -e "do shell script \"$1\" with administrator privileges with prompt \"$2\"" >/dev/null
}

write_plist() {
  /bin/mkdir -p "$HOME/Library/LaunchAgents" "$HOME/Library/Logs"
  /bin/cat > "$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>$SELF</string><string>_watch</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>StandardErrorPath</key><string>$HOME/Library/Logs/travel-mode.err.log</string>
</dict>
</plist>
EOF
}

watcher_start() {
  write_plist
  /bin/launchctl bootout "gui/$(/usr/bin/id -u)/$LABEL" 2>/dev/null || true
  /bin/launchctl bootstrap "gui/$(/usr/bin/id -u)" "$PLIST"
}

watcher_stop() {
  /bin/launchctl bootout "gui/$(/usr/bin/id -u)/$LABEL" 2>/dev/null || true
  /bin/rm -f "$PLIST"
}

watcher_running() {
  /bin/launchctl print "gui/$(/usr/bin/id -u)/$LABEL" 2>/dev/null | /usr/bin/grep -q 'state = running'
}

lock_now() {
  if [ -x "$BIN_DIR/lockscreen" ] && "$BIN_DIR/lockscreen"; then return 0; fi
  /usr/bin/pmset displaysleepnow   # fallback: locks if "Require password" is set to Immediately
}

cmd_watch() { # run by launchd while travel mode is on; exits when it is off
  # Every 2 s: lock the screen when the lid closes.
  # Every 10 s: remember the hotspot we're on; if Wi-Fi drops to nothing, try to rejoin it
  # (every 30 s for 5 minutes, then every 2 minutes). Another network or Wi-Fi off = leave it alone.
  local prev_lid="No" lid tick=0 state prev_state="" lost_at=0 last_try=0 tries=0 gap now name dev i seq
  dev=$(wifi_dev)
  while :; do
    is_on || exit 0

    if [ -z "$TM_TEST" ]; then
      lid=$(/usr/sbin/ioreg -r -k AppleClamshellState -d 1 | /usr/bin/awk -F'= ' '/"AppleClamshellState"/ {print $2; exit}')
      if [ "$lid" = "Yes" ] && [ "$prev_lid" != "Yes" ]; then
        lock_now
        tm_log "lid closed -> screen locked"
      fi
      prev_lid="$lid"
    fi

    if [ $((tick % 5)) -eq 0 ]; then
      if [ -n "$TM_TEST" ]; then
        IFS=',' read -r -a seq <<< "${TM_TEST_WIFI:-none}"
        i=$((tick / 5)); [ "$i" -ge "${#seq[@]}" ] && i=$((${#seq[@]} - 1))
        state="${seq[$i]}"; now=$((1000 + tick * 2))
      else
        state=$(cmd_wifi | /usr/bin/cut -f1); now=$(/bin/date +%s)
      fi
      case "$state" in
        hotspot)
          if [ -n "$TM_TEST" ]; then name="${TM_TEST_NAME:-}"; else name=$(wifi_name || true); fi
          if [ -n "$name" ] && [ "$name" != "$(cmd_hotspot || true)" ]; then
            cmd_hotspot "$name" >/dev/null
            tm_log "remembered hotspot: $name"
          fi
          [ "$lost_at" -gt 0 ] && tm_log "back on the hotspot after $((now - lost_at)) s"
          lost_at=0; tries=0 ;;
        none)
          if [ "$lost_at" -eq 0 ]; then
            lost_at=$now
            tm_log "Wi-Fi disconnected (was: ${prev_state:-unknown})"
          fi
          name=$(cmd_hotspot || true)
          gap=30; [ "$tries" -ge 10 ] && gap=120
          if [ -n "$name" ] && [ $((now - lost_at)) -ge 10 ] && [ $((now - last_try)) -ge "$gap" ]; then
            tries=$((tries + 1)); last_try=$now
            if [ -n "$TM_TEST" ]; then
              tm_log "reconnect attempt $tries: would join $name"
            else
              tm_log "reconnect attempt $tries: joining $name"
              ( out=$(/usr/sbin/networksetup -setairportnetwork "$dev" "$name" 2>&1); [ -n "$out" ] && tm_log "  $out" ) &
            fi
          fi ;;
        *)  # other network or Wi-Fi off: the user's choice, leave it alone
          if [ "$prev_state" = "hotspot" ] || [ "$lost_at" -gt 0 ]; then tm_log "now on: $state (not reconnecting)"; fi
          lost_at=0; tries=0 ;;
      esac
      prev_state=$state
    fi

    tick=$((tick + 1))
    if [ -n "$TM_TEST" ]; then
      [ "$tick" -ge "${TM_TEST_TICKS:-1}" ] && exit 0
      /bin/sleep "${TM_TEST_SLEEP:-0}"
    else
      /bin/sleep 2
    fi
  done
}

cmd_on() {
  admin "/usr/bin/pmset -a disablesleep 1" "Travel Mode wants to keep this Mac awake with the lid closed." || { echo "Cancelled. Nothing changed."; exit 1; }
  watcher_start
  echo "Travel Mode ON: stays awake with the lid closed and locks when you close it."
}

cmd_off() {
  admin "/usr/bin/pmset -a disablesleep 0" "Travel Mode wants to restore normal sleep." || { echo "Cancelled. Nothing changed."; exit 1; }
  watcher_stop
  echo "Travel Mode OFF: normal sleep is back."
}

cmd_wifi() {
  local d dev
  for d in $(/usr/sbin/networksetup -listallhardwareports | /usr/bin/awk '/^Device:/{print $2}'); do
    if [ "$(/usr/sbin/ipconfig getoption "$d" router 2>/dev/null)" = "$HOTSPOT_ROUTER" ]; then
      local n=""
      [ "$d" = "$(wifi_dev)" ] && n=$(wifi_name || true)
      if [ -n "$n" ]; then printf 'hotspot\t✓ On your iPhone hotspot (%s)\n' "$n"
      else printf 'hotspot\t✓ On your iPhone hotspot\n'; fi
      return 0
    fi
  done
  dev=$(wifi_dev)
  if [ -n "$dev" ] && /usr/sbin/networksetup -getairportpower "$dev" | /usr/bin/grep -q ': Off'; then
    printf 'off\t⚠︎ Wi-Fi is off\n'; return 0
  fi
  if [ -z "$dev" ] || [ -z "$(/usr/sbin/ipconfig getoption "$dev" router 2>/dev/null)" ]; then
    printf 'none\t⚠︎ Wi-Fi is not connected\n'; return 0
  fi
  local n; n=$(wifi_name || true)
  if [ -n "$n" ]; then printf 'other\t⚠︎ On %s, not your iPhone hotspot\n' "$n"
  else printf 'other\t⚠︎ Not on your iPhone hotspot (another Wi-Fi network)\n'; fi
}

cmd_hotspot() {
  if [ $# -gt 0 ] && [ -n "$1" ]; then
    /bin/mkdir -p "$CONF_DIR"; printf '%s\n' "$1" > "$HOTSPOT_FILE"
  fi
  [ -s "$HOTSPOT_FILE" ] && /usr/bin/head -1 "$HOTSPOT_FILE"
}

cmd_networks() {
  /usr/sbin/networksetup -listpreferredwirelessnetworks "$(wifi_dev)" 2>/dev/null | /usr/bin/tail -n +2 | /usr/bin/sed 's/^[[:space:]]*//'
}

cmd_join() {
  local name="${1:-}" dev out i
  [ -n "$name" ] || name=$(cmd_hotspot)
  [ -n "$name" ] || { echo "No hotspot name set. Run: travel-mode hotspot \"<name>\""; exit 1; }
  dev=$(wifi_dev)
  /usr/sbin/networksetup -setairportpower "$dev" on
  out=$(/usr/sbin/networksetup -setairportnetwork "$dev" "$name" 2>&1)
  for i in $(/usr/bin/seq 1 20); do
    if cmd_wifi | /usr/bin/grep -q '^hotspot'; then echo "Joined $name"; return 0; fi
    /bin/sleep 1
  done
  echo "Could not join $name. ${out}"; exit 1
}

cmd_uninstall() { # used by the app's "Uninstall Travel Mode…" (Travel Mode must already be off)
  watcher_stop
  /bin/rm -rf "$CONF_DIR" "$LOG" "$HOME/Library/Logs/travel-mode.err.log"
  local link="$HOME/.local/bin/travel-mode"
  if [ -L "$link" ] && [ "$(/usr/bin/readlink -f "$link")" = "$SELF" ]; then /bin/rm -f "$link"; fi
}

cmd_status() {
  if is_on; then echo "Travel Mode: ON (lid close will not sleep)"; else echo "Travel Mode: OFF (normal sleep)"; fi
  if watcher_running; then echo "Watcher:     on (locks on lid close, rejoins the hotspot if Wi-Fi drops)"; else echo "Watcher:     off"; fi
  echo "Wi-Fi:       $(cmd_wifi | /usr/bin/cut -f2)"
  echo "Rejoins:     $(cmd_hotspot || echo "no hotspot remembered yet")"
  echo "Battery:     $(/usr/bin/pmset -g batt | /usr/bin/grep -Eo '[0-9]+%' | /usr/bin/head -1)"
}

case "${1:-status}" in
  on)       cmd_on ;;
  off)      cmd_off ;;
  toggle)   if is_on; then cmd_off; else cmd_on; fi ;;
  status)   cmd_status ;;
  is-on)    is_on ;;
  wifi)     cmd_wifi ;;
  join)     shift; cmd_join "${1:-}" ;;
  hotspot)  shift; cmd_hotspot "${1:-}" ;;
  networks) cmd_networks ;;
  log)      /usr/bin/tail -n "${2:-20}" "$LOG" 2>/dev/null || echo "No events yet." ;;
  _watch)   cmd_watch ;;
  _rewatch) if is_on; then watcher_start; fi ;;
  _uninstall) if is_on; then echo "Turn Travel Mode off first."; exit 1; fi; cmd_uninstall ;;   # after install/upgrade: point the watcher at this copy
  -h|--help|help) /usr/bin/sed -n '2,10p' "$SELF" | /usr/bin/sed 's/^# \{0,1\}//' ;;
  *) echo "Unknown command: $1 (try: travel-mode help)"; exit 2 ;;
esac
